# Copy to `.env` for local development (optional — you can also set Server URL in the app login screen).

# Central CheckinAccess API (no trailing /api)
# Emulator: http://10.0.2.2:8000
# Physical phone on same Wi‑Fi as PC: http://192.168.x.x:8000
# Production: https://checkin-api.learnnowsyria.com
EXPO_PUBLIC_API_BASE=http://10.0.2.2:8000

# Must match Laravel TTLOCK_CLIENT_ID when using legacy TTLock cloud initialize from the app
EXPO_PUBLIC_TTLOCK_CLIENT_ID=

# Set by EAS profiles; leave unset for local `expo run:android`
# EXPO_PUBLIC_APP_VARIANT=development
