{
  "name": "checkinhousinglocksetupexpo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@tanstack/react-query": "^5.104.4",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.8",
    "expo-haptics": "^58.0.7",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.30",
    "expo-secure-store": "^58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.5.2",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-ttlock": "^2.3.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start --dev-client --host lan --port 8081",
    "dev": "expo start --dev-client -c --host lan --port 8081",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android && node scripts/patch-android-gradle-properties.mjs",
    "prebuild:clean": "expo prebuild --clean --platform android --no-install && node scripts/patch-android-gradle-properties.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:production": "eas build --profile production --platform android",
    "verify:lock-wire": "node scripts/verify-lock-data-wire.mjs"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-ttlock"
        ]
      }
    }
  }
}
