+    /**
+     * TTLock Android SDK: prepareBTService must run first or APIs fail with
+     * "ttlock not init or bluetooth is disable" (common in release/production builds).
+     */
+    private static volatile boolean btServicePrepared = false;
+
+    private void ensureBtServicePrepared() {
+        // Once only: prepareBTService replaces the SDK's Handler on every call, which
+        // orphans a pending connect-timeout timer that then kills a later connection.
+        if (btServicePrepared) {
+            return;
+        }
+        Activity activity = getCurrentActivity();
+        android.content.Context context = activity != null
+            ? activity.getApplicationContext()
+            : reactContext.getApplicationContext();
+        if (context == null) {
+            return;
+        }
+        TTLockClient.getDefault().prepareBTService(context);
+        RemoteClient.getDefault().prepareBTService(context);
+        WirelessDoorSensorClient.getDefault().prepareBTService(context);
+        GatewayClient.getDefault().prepareBTService(context);
+        btServicePrepared = true;
+    }
+
+    /**
+     * The SDK retries a connection that drops right away (Android GATT 133) up to 3 times,
+     * but it never re-arms that retry: after the first successful connection of the process
+     * every such drop surfaces as "connect timeout". Re-arm it before each lock command.
+     * BluetoothImpl is package-private, hence reflection; failure here is harmless.
+     */
+    private void rearmSdkReconnect() {
+        try {
+            Class<?> impl = Class.forName("com.ttlock.bl.sdk.api.BluetoothImpl");
+            java.lang.reflect.Method getInstance = impl.getDeclaredMethod("getInstance");
+            getInstance.setAccessible(true);
+            Object instance = getInstance.invoke(null);
+            java.lang.reflect.Method setNeedReCon = impl.getDeclaredMethod("setNeedReCon", boolean.class);
+            setNeedReCon.setAccessible(true);
+            setNeedReCon.invoke(instance, true);
+            java.lang.reflect.Method setConnectCnt = impl.getDeclaredMethod("setConnectCnt", int.class);
+            setConnectCnt.setAccessible(true);
+            setConnectCnt.invoke(instance, 0);
+        } catch (Throwable t) {
+            Log.w("Ttlock", "rearmSdkReconnect skipped: " + t);
+        }
+    }
 
